<UserControl x:Class="AmnesiaManager.Views.NavigationControls.PasswordEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:AmnesiaManager.Views.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="300" 
             d:DesignWidth="250">
    <DockPanel>
        <controls:SubtitlePanelControl Text="Creating a password"
                                       DockPanel.Dock="Top"/>
        
        <StackPanel VerticalAlignment="Top">
            <controls:PlaceholderIconFieldControl Placeholder="Name or url"
                                                  Margin="0 10 0 0"
                                                  CornerRadius="{DynamicResource SecondaryCornerRadius}"/>

            <controls:PlaceholderIconFieldControl Placeholder="Login or email"
                                                  Margin="0 15 0 0"
                                                  CornerRadius="{DynamicResource SecondaryCornerRadius}"/>

            <controls:PlaceholderIconFieldControl Placeholder="Password"
                                                  Margin="0 15 0 0"
                                                  CornerRadius="{DynamicResource SecondaryCornerRadius}"/>

            <Grid Margin="0 15 0 0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Style="{DynamicResource FlatButton}" 
                        Margin="0 0 15 10"
                        IsDefault="True"
                        Content="Cancel"
                        Background="{DynamicResource RedColorBrush}"/>

                <Button Grid.Column="1"
                        Style="{DynamicResource FlatButton}" 
                        Margin="0 0 0 10"
                        IsDefault="True"
                        Content="Sign in"
                        VerticalAlignment="Center"
                        Background="{DynamicResource LimeColorBrush}"/>
            </Grid>
        </StackPanel>
    </DockPanel>
</UserControl>

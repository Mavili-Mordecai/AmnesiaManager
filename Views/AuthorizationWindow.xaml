<Window x:Class="AmnesiaManager.Views.AuthorizationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AmnesiaManager.Views"
        xmlns:viewModels="clr-namespace:AmnesiaManager.ViewModels"
        xmlns:controls="clr-namespace:AmnesiaManager.Views.Controls"
        mc:Ignorable="d"
        AllowsTransparency="True"
        Topmost="True"
        Title="Authorization" 
        Loaded="OnLoaded"
        Style="{StaticResource MainWindow}">
    <Window.DataContext>
        <viewModels:AuthorizationViewModel/>
    </Window.DataContext>

    <Grid>
        <Canvas Height="{StaticResource MainWindowHeight}"
                Width="{StaticResource MainWindowWidth}">
            <Border Style="{DynamicResource ContentBox}"
                    x:Name="BorderContent"
                    Height="{StaticResource MainWindowHeight}"
                    Width="{StaticResource MainWindowWidth}"
                    Canvas.Right="0"
                    Canvas.Top="0"
                    Padding="0"
                    ClipToBounds="True">
                <Grid Margin="50 0 50 15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="3*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                        <Image Source="{DynamicResource ClosedLockIcon}"
                               Width="15"
                               Height="15"
                               Margin="0 0 10 8"/>

                        <TextBlock Text="{Binding ApplicationName}"
                                   FontSize="32"
                                   FontFamily="{StaticResource Dongle}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1"
                                VerticalAlignment="Stretch"
                                HorizontalAlignment="Stretch">
                        <TextBlock Text="{Binding Title, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                                   FontSize="28"
                                   FontFamily="{StaticResource Dongle}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>

                        <controls:PlaceholderIconFieldControl Placeholder="Password"
                                                              CornerRadius="{DynamicResource SecondaryCornerRadius}"
                                                              FontFamily="{StaticResource Password}"
                                                              Icon="{DynamicResource LockIcon}"
                                                              Text="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              MaxLength="300"/>

                        <controls:PlaceholderIconFieldControl Placeholder="Repeat"
                                                              Visibility="{Binding ConfirmPasswordVisibility}"
                                                              FontFamily="{StaticResource Password}"
                                                              Margin="0 15 0 0"
                                                              CornerRadius="{DynamicResource SecondaryCornerRadius}"
                                                              Icon="{DynamicResource LockIcon}"
                                                              Text="{Binding ConfirmPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              MaxLength="300"/>

                        <Button Style="{DynamicResource FlatButton}" 
                                Margin="0 15 0 10"
                                IsDefault="True"
                                Content="Sign in"
                                Background="{DynamicResource LimeColorBrush}"
                                Command="{Binding LoginCommand}"/>

                        <TextBlock Foreground="{DynamicResource RedColorBrush}"
                                   HorizontalAlignment="Center"
                                   FontSize="11"
                                   Visibility="{Binding FormError.Visibility, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                   Text="{Binding FormError.Message, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Canvas>
    </Grid>
</Window>

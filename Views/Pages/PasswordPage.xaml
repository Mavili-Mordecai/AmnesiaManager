<Page x:Class="AmnesiaManager.Views.Pages.PasswordPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:AmnesiaManager.Views.Pages"
      xmlns:controls="clr-namespace:AmnesiaManager.Views.Controls"
      xmlns:viewModels="clr-namespace:AmnesiaManager.ViewModels"
      xmlns:helpers="clr-namespace:AmnesiaManager.Helpers"
      xmlns:system="clr-namespace:System;assembly=System.Runtime"
      mc:Ignorable="d" 
      d:DesignHeight="300" 
      d:DesignWidth="250"
      x:Name="Page">
    <Page.DataContext>
        <viewModels:PasswordPageViewModel/>
    </Page.DataContext>

    <Page.Resources>
        <CollectionViewSource x:Key="PasswordsCollection"
                              Source="{Binding VisiblePasswords}"/>

        <helpers:TextToShortTextConverter x:Key="TextToShortTextConverter"/>
        <system:Int32 x:Key="MaxQuantityLetters">32</system:Int32>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Search Fields -->
        <controls:PlaceholderIconFieldControl Grid.Row="0"
                                              VerticalAlignment="Top"
                                              Placeholder="Search"
                                              CornerRadius="{DynamicResource SecondaryCornerRadius}"
                                              Icon="{DynamicResource SearchIcon}"
                                              Text="{Binding SearchText, Mode=OneWayToSource, UpdateSourceTrigger=PropertyChanged}"/>

        <!-- Table -->
        <Border CornerRadius="{DynamicResource SecondaryCornerRadius}"
                BorderThickness="1"
                Grid.Row="1"
                Margin="0 10 0 0"
                BorderBrush="{DynamicResource SecondaryColorBrush}">

            <!-- List of the passwords -->
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          Margin="10 5"
                          VerticalScrollBarVisibility="Hidden">
                <ItemsControl ItemsSource="{Binding Source={StaticResource PasswordsCollection}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource SecondaryColorBrush}"
                                    CornerRadius="{DynamicResource SecondaryCornerRadius}"
                                    Padding="20 8"
                                    Margin="0 5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <Button Style="{DynamicResource ButtonContent}"
                                                Command="{Binding ElementName=Page, Path=DataContext.CopyTextCommand}"
                                                CommandParameter="{Binding Label}">
                                            <TextBlock ToolTip="{Binding Label}"
                                                       Text="{Binding Path=Label, Converter={StaticResource TextToShortTextConverter}, ConverterParameter={StaticResource MaxQuantityLetters}}"/>
                                        </Button>

                                        <Button Style="{DynamicResource ButtonContent}"
                                                Command="{Binding ElementName=Page, Path=DataContext.CopyTextCommand}"
                                                CommandParameter="{Binding Login}">
                                            <TextBlock ToolTip="{Binding Login}"
                                                       Text="{Binding Path=Login, Converter={StaticResource TextToShortTextConverter},ConverterParameter={StaticResource MaxQuantityLetters}}"/>
                                        </Button>
                                    </StackPanel>

                                    <Button Style="{DynamicResource ButtonContent}"
                                            Grid.Column="1"
                                            ToolTip="Copy password"
                                            Command="{Binding ElementName=Page, Path=DataContext.CopyTextCommand}"
                                            CommandParameter="{Binding Password}">
                                        <Image Source="{DynamicResource CopyIcon}"
                                               Width="18"
                                               Height="18"/>
                                    </Button>
                                </Grid>

                                <Border.ContextMenu>
                                    <ContextMenu Style="{DynamicResource ContextMenu}">
                                        <MenuItem Header="Edit"/>
                                        <MenuItem Header="Remove"/>
                                    </ContextMenu>
                                </Border.ContextMenu>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>

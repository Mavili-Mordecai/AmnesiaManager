<UserControl x:Class="AmnesiaManager.Views.Controls.HyperlinkControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AmnesiaManager.Views.Controls"
             mc:Ignorable="d" 
             x:Name="UserControl"
             d:DesignHeight="450" 
             d:DesignWidth="800">
    <Button Style="{DynamicResource ButtonContent}"
            Click="LinkClick">
        <TextBlock Text="{Binding ElementName=UserControl, Path=Text}" 
                   Foreground="{Binding ElementName=UserControl, Path=Foreground}"
                   Background="{Binding ElementName=UserControl, Path=Background}"
                   FontSize="{Binding ElementName=UserControl, Path=FontSize}"
                   FontFamily="{Binding ElementName=UserControl, Path=FontFamily}"
                   FontStyle="{Binding ElementName=UserControl, Path=FontStyle}"
                   FontWeight="{Binding ElementName=UserControl, Path=FontWeight}"/>
    </Button>
</UserControl>

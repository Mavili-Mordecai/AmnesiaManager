<Page x:Class="AmnesiaManager.Views.NavigationPages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:controls="clr-namespace:AmnesiaManager.Views.Controls"
      xmlns:viewModels="clr-namespace:AmnesiaManager.ViewModels"
      mc:Ignorable="d"
      d:DesignHeight="450"
      d:DesignWidth="800">
    <Page.DataContext>
        <viewModels:SettingsViewModel />
    </Page.DataContext>

    <DockPanel>
        <controls:SubtitlePanelControl VerticalAlignment="Top"
                                       Text="Settings"
                                       DockPanel.Dock="Top" />

        <StackPanel VerticalAlignment="Top"
                    Margin="0 10 0 0">
            <Border Background="{DynamicResource SecondaryColorBrush}"
                    Padding="10"
                    CornerRadius="{DynamicResource SecondaryCornerRadius}">
                <StackPanel>
                    <TextBlock Text="Change password"
                               FontSize="14" />

                    <Grid Margin="0 10 0 0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0 0 7.5 5">
                            <TextBlock Text="New password"
                                       Margin="0 0 0 5" />

                            <controls:PasswordBoxControl Icon="{DynamicResource ClosedLockIcon}"
                                                         BorderBrush="{DynamicResource TextColorBrush}"
                                                         CornerRadius="{DynamicResource SecondaryCornerRadius}"
                                                         Password="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="7.5 0 0 0">
                            <TextBlock Text="Confirm password"
                                       Margin="0 0 0 5" />

                            <controls:PasswordBoxControl Icon="{DynamicResource ClosedLockIcon}"
                                                         BorderBrush="{DynamicResource TextColorBrush}"
                                                         CornerRadius="{DynamicResource SecondaryCornerRadius}"
                                                         Password="{Binding ConfirmPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Foreground="{DynamicResource RedColorBrush}"
                               FontSize="11"
                               Visibility="{Binding PasswordFormError.Visibility, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                               Text="{Binding PasswordFormError.Message, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <Button Style="{DynamicResource FlatButton}"
                            Background="{DynamicResource LimeColorBrush}"
                            Margin="0 10 0 0"
                            Content="Save"
                            Command="{Binding SaveNewPasswordCommand, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </DockPanel>
</Page>
<Window x:Class="AmnesiaManager.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        xmlns:viewModels="clr-namespace:AmnesiaManager.ViewModels"
        mc:Ignorable="d"
        Title="{Binding ApplicationName}" 
        Topmost="True"
        Loaded="OnLoaded"
        AllowsTransparency="True"
        Style="{StaticResource MainWindow}">
    <Window.DataContext>
        <viewModels:MainWindowViewModel/>
    </Window.DataContext>

    <Grid>
        <tb:TaskbarIcon x:Name="TaskbarIcon"
                        Visibility="Visible" 
                        ToolTipText="{Binding ApplicationName}" 
                        IconSource="/Icons/keys.ico"
                        TrayLeftMouseDown="ToggleWindow">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu Style="{DynamicResource ContextMenu}">
                    <MenuItem Header="Закрыть"
                              Command="{Binding ExitCommand}"/>
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>

        <Canvas Height="{StaticResource MainWindowHeight}"
                Width="{StaticResource MainWindowWidth}">
            <Border Style="{DynamicResource ContentBox}"
                    x:Name="BorderContent"
                    Height="{StaticResource MainWindowHeight}"
                    Width="{StaticResource MainWindowWidth}"
                    Canvas.Right="0"
                    Canvas.Top="0"
                    Padding="0"
                    ClipToBounds="True">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Button Style="{DynamicResource ButtonContent}"
                                    Margin="0 0 10 8"
                                    Command="{Binding LockTheAppCommand}"
                                    ToolTip="Block the app"
                                    VerticalAlignment="Center">
                                <Image Source="{DynamicResource FlatLockIcon}"
                                       Width="15"
                                       Height="15"/>
                            </Button>

                            <TextBlock Text="{Binding ApplicationName}"
                                       FontSize="32"
                                       FontFamily="{StaticResource Dongle}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        

                        <Button Style="{DynamicResource ButtonContent}"
                                Grid.Column="1"
                                ToolTip="Open the Settings window"
                                Margin="0 0 5 0">
                            <Image Width="22"
                                   Height="22"
                                   Source="{DynamicResource SettingsIcon}"/>
                        </Button>
                    </Grid>

                    <Frame Grid.Row="1" 
                           NavigationUIVisibility="Hidden"
                           Content="{Binding Path=CurrentPage, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>
            </Border>
        </Canvas>
    </Grid>
</Window>

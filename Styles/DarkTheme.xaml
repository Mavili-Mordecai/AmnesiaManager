<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Palette of colors -->
    <Color x:Key="PrimaryColor">#191919</Color>
    <Color x:Key="SecondaryColor">#222</Color>
    
    <SolidColorBrush x:Key="TextColorBrush" Color="#fff"/>
    <SolidColorBrush x:Key="PrimaryColorBrush" Color="{DynamicResource PrimaryColor}"/>
    <SolidColorBrush x:Key="SecondaryColorBrush" Color="{DynamicResource SecondaryColor}"/>
    <SolidColorBrush x:Key="AccentColorBrush" Color="#fed428"/>
    <SolidColorBrush x:Key="RedColorBrush" Color="#c85961"/>

    <!-- Icons -->
    <BitmapImage x:Key="CloseIcon" UriSource="/Icons/close/white.png"/>
    <BitmapImage x:Key="MinimizeIcon" UriSource="/Icons/minimize/white.png"/>
    <BitmapImage x:Key="SettingsIcon" UriSource="/Icons/settings/white.png"/>
</ResourceDictionary>
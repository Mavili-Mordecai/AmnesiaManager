<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Palette of colors -->
    <Color x:Key="PrimaryColor">#191919</Color>
    <Color x:Key="SecondaryColor">#292929</Color>
    <Color x:Key="TertiaryColor">#393939</Color>

    <SolidColorBrush x:Key="TextColorBrush" Color="#fff" />
    <SolidColorBrush x:Key="PrimaryColorBrush" Color="{DynamicResource PrimaryColor}" />
    <SolidColorBrush x:Key="SecondaryColorBrush" Color="{DynamicResource SecondaryColor}" />
    <SolidColorBrush x:Key="TertiaryColorBrush" Color="{DynamicResource TertiaryColor}" />
    <SolidColorBrush x:Key="AccentColorBrush" Color="#fed428" />
    <SolidColorBrush x:Key="RedColorBrush" Color="#c85961" />
    <SolidColorBrush x:Key="LimeColorBrush" Color="#4bb34b" />
    <SolidColorBrush x:Key="LightBlueColorBrush" Color="#2b9dd5" />

    <!-- Icons -->
    <BitmapImage x:Key="CloseIcon" UriSource="/Resources/Icons/close/white.png" />
    <BitmapImage x:Key="MinimizeIcon" UriSource="/Resources/Icons/minimize/white.png" />
    <BitmapImage x:Key="SettingsIcon" UriSource="/Resources/Icons/settings/white.png" />
    <BitmapImage x:Key="CopyIcon" UriSource="/Resources/Icons/copy/white.png" />
    <BitmapImage x:Key="PlusIcon" UriSource="/Resources/Icons/plus/white.png" />
    <BitmapImage x:Key="OpenLockIcon" UriSource="/Resources/Icons/open-lock/white.png" />
    <BitmapImage x:Key="ClosedLockIcon" UriSource="/Resources/Icons/closed-lock/white.png" />
    <BitmapImage x:Key="LeftArrowIcon" UriSource="/Resources/Icons/arrow-left/white.png" />
    <BitmapImage x:Key="SearchIcon" UriSource="/Resources/Icons/search.png" />
    <BitmapImage x:Key="LockIcon" UriSource="/Resources/Icons/lock.png" />
    <BitmapImage x:Key="LogoIcon" UriSource="/Resources/Icons/keys.png" />
</ResourceDictionary>